# Public, client-safe PostHog project configuration. Never use a personal API key here.
EXPO_PUBLIC_POSTHOG_KEY=phc_your_public_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://your-region.i.posthog.com

# Optional. Development builds are detected automatically; set this to preview for preview builds.
EXPO_PUBLIC_APP_ENV=development

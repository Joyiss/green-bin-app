{
  "expo": {
    "name": "Green Bin",
    "slug": "green-bin-app",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "greenbinapp",

    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.rakshan1234.greenbinapp",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,

      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],

      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#E6F4FE"
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-camera",
        {
          "cameraPermission": "Allow Green Bin to use your camera to scan recyclable items."
        }
      ],

      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Green Bin to access your photos so you can upload an item to scan."
        }
      ],

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Green Bin to use your location to find nearby recycling sites."
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "1daefbaa-d762-47c0-b6cf-9d9d5a04b8ac"
      }
    },

    "owner": "rakshan1234"
  }
}
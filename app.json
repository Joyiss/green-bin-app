{
  "expo": {
    "name": "Green Bin",
    "slug": "green-bin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#F3F1EE",
    "scheme": "greenbinapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mallelalabs.greenbin",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#F3F1EE"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content",
      "hidden": false,
      "translucent": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#00000000",
          "barStyle": "dark",
          "borderColor": "#00000000",
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "position": "absolute"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Green Bin to use your camera to scan recyclable items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Green Bin to access your photos so you can upload an item to scan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Green Bin to use your location for local disposal guidance and nearby recycling sites."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F1EE",
          "dark": {
            "backgroundColor": "#F3F1EE"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1daefbaa-d762-47c0-b6cf-9d9d5a04b8ac"
      }
    },
    "owner": "rakshan1234"
  }
}
